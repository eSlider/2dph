#!/usr/bin/env bash
# bin/stack/serve-brain - start 2dph brain the memory-safe way (2 processes).
#
#   bin/stack/serve-brain          # build if needed, then daemon + API
#   bin/stack/serve-brain --build  # force rebuild binaries first
#
# WHY 2 PROCESSES (memory fix 2026-08-19):
# Running brain/serve.go alone made every search load the 512MB embedding
# matrix in-process (Close() frees only the tokenizer, not the matrix) and
# spawned ~20 zombie [serve] subprocesses (os.Executable can't handle the
# `serve` subcommand). RSS grew to 5.2GB. The Docker entrypoint already does
# this correctly: start `brain-search serve <port>` (loads the model ONCE),
# then `brain-serve` (API) which proxies embedding requests to the daemon.
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)"
BUILD_DIR="$ROOT/bin-build"
PORT="${KB_PORT:-8630}"
SEARCH_PORT="${KBSEARCH_PORT:-17830}"

build() {
  echo "build: compiling static binaries (Zig CGO)" >&2
  mkdir -p "$BUILD_DIR"
  eval "$("$ROOT/bin/cgo/zig" env)"
  go build -tags=brain_serve,system_ladybug -o "$BUILD_DIR/brain-serve" "$ROOT/bin/brain/serve.go"
  go build -tags=system_ladybug -o "$BUILD_DIR/brain-search" "$ROOT/bin/brain/search.go"
  go build -tags=system_ladybug,brain_index -o "$BUILD_DIR/brain-index" "$ROOT/bin/brain/index.go"
}

if [[ "${1:-}" == "--build" || ! -x "$BUILD_DIR/brain-serve" || ! -x "$BUILD_DIR/brain-search" ]]; then
  build
fi

if curl -sS -o /dev/null --max-time 3 "http://127.0.0.1:$SEARCH_PORT/health" 2>/dev/null; then
  echo "search daemon: reuse :$SEARCH_PORT" >&2
else
  echo "search daemon: start :$SEARCH_PORT" >&2
  setsid nohup "$BUILD_DIR/brain-search" serve "$SEARCH_PORT" \
    > /tmp/opencode/brain-daemon.log 2>&1 < /dev/null &
  disown
fi

if curl -sS --max-time 3 "http://127.0.0.1:$PORT/health" 2>/dev/null | grep -q '"status":"ok"'; then
  echo "brain API: reuse :$PORT" >&2
else
  echo "brain API: start :$PORT (workers=4)" >&2
  KB_PORT="$PORT" KB_WORKERS=4 setsid nohup "$BUILD_DIR/brain-serve" \
    > /tmp/opencode/2dph-brain.log 2>&1 < /dev/null &
  disown
fi

echo "brain: http://127.0.0.1:$PORT (MCP /mcp)" >&2
echo "daemon: http://127.0.0.1:$SEARCH_PORT" >&2