#!/usr/bin/env bash
# scripts/stack/start-assistant - start + CPU reasoner + PicoClaw, then attach agent.
#
#   scripts/stack/start-assistant
#   scripts/stack/start-assistant --no-attach
#   scripts/stack/start-assistant -- -m "search the 2dph brain for LadybugDB"
#
# Pulls qwen3.5:9b if missing. Gateway :18790. Agent uses MCP search → get → audit.
# --no-attach leaves the gateway up without exec.
set -euo pipefail

STACK_DIR="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
# shellcheck source=lib.sh
source "$STACK_DIR/lib.sh"
stack_start_assistant "$@"
